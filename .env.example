# Copy to .env and fill in. .env is gitignored; never commit real values.
# Only needed for the optional remote runner and for publishing; local training needs neither.

# Hugging Face token (write access) used by jtalm.data.publish / jtalm.model.release publish
HF_TOKEN=
# vast.ai API key used by jtalm.infra.job (rents GPUs; every run needs --approve-dph)
VAST_API_KEY=
