diff --git a/main/llm.c b/main/llm.c
index 73efa1d..201d870 100644
--- a/main/llm.c
+++ b/main/llm.c
@@ -32,6 +32,7 @@
 
 #include "esp_dsp.h"
 #include "esp_heap_caps.h"
+#include "esp_timer.h"
 #include "esp_log.h"
 #include "freertos/FreeRTOS.h"
 #include "freertos/task.h"
@@ -741,12 +742,15 @@ void generate(
   // start the main loop
   long start =
       0;     // used to time our code, only initialized after first iteration
+  int64_t fwd_us = 0;  // JTALM: time spent in forward() after the first token
   int next;  // will store the next token in the sequence
   int token = prompt_tokens[0];  // kick off with the first token in the prompt
   int pos = 0;                   // position in the sequence
   while (pos < steps) {
     // forward the transformer to get logits for the next token
+    int64_t fwd_t0 = esp_timer_get_time();  // JTALM: forward-only timing
     float* logits = forward(transformer, token, pos);
+    if (start != 0) fwd_us += esp_timer_get_time() - fwd_t0;
 
     // advance the state machine
     if (pos < num_prompt_tokens - 1) {
@@ -813,6 +817,10 @@ void generate(
     ESP_LOGI(
         TAG, "achieved tok/s: %f\n", (pos - 1) / (double)(end - start) * 1000
     );
+    ESP_LOGI(
+        TAG, "JTALM tokens: %d, forward-only tok/s: %f, ms/token: %f", pos - 1,
+        (pos - 1) / (fwd_us / 1e6), fwd_us / 1000.0 / (pos - 1)
+    );
   }
 
   free(prompt_tokens);
